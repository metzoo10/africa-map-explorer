{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": ".out-spec-ts",
    "rootDir": "./src/app",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/app/**/*.d.ts",
    "src/app/**/*.spec.ts"
